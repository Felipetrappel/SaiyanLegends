{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saiyanlegends",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./", "binding": "ASSETS", "run_worker_first": ["/ws", "/healthz", "/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "saiyanlegends-db", "database_id": "470c8745-755a-44c1-978c-709faa24cd3a" }],
  "durable_objects": { "bindings": [{ "name": "WORLD", "class_name": "World" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["World"] }]
}
